# Copiá este archivo como .env y completá tus claves reales.
# El archivo .env está en .gitignore: NUNCA se sube a GitHub.
# Sin claves podés correr todo en modo mock: MODO_MOCK=1 (API) o python main.py --mock (consola)

# Anthropic: https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
# Modelo de Claude que usan los agentes
ANTHROPIC_MODEL=claude-haiku-5-5

# Tavily (búsqueda web para agentes): https://app.tavily.com -> API Keys
TAVILY_API_KEY=

# LangSmith (trazas, costo y latencia): https://smith.langchain.com -> Settings -> API Keys
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=pre-entrega-7
# Solo si tu cuenta de LangSmith es de la región EU:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Redis 8+ o Redis Stack (trae RedisJSON + RediSearch, los necesita el checkpointer).
# docker compose: lo pone solo (redis://redis:6379/0). Local: redis://localhost:6379/0
# Redis Cloud: redis://default:<password>@<host>:<puerto>/0
# Vacío = fakeredis en memoria + InMemorySaver (solo para probar; nada persiste)
REDIS_URL=

# 1 = modo mock (LLM con respuestas prefijadas + Tavily simulado)
MODO_MOCK=0
# Cuántos grafos corren a la vez (el resto espera en PENDING) y tope de segundos por tramo
MAX_JOBS_CONCURRENTES=5
JOB_TIMEOUT_S=900
